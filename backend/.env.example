# Copy this file to .env and fill in real values.
# Never commit .env.
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# JWT – generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

# bcrypt cost factor (10–14 is reasonable)
BCRYPT_SALT_ROUNDS=12

# PostgreSQL – two roles (scripts/setup-db-roles.js, run with: npm run db:roles)
# DATABASE_URL: the API's LIMITED role – rows only, no schema changes, cannot disable triggers or rewrite history.
#   Its password: 24+ characters of A–Z a–z 0–9 _ - (generate: openssl rand -base64 32 | tr -dc A-Za-z0-9 | head -c 40)
#   npm run db:roles creates the role with exactly this name and password.
DATABASE_URL="postgresql://ledgerline_api:change-me-to-a-long-random-password@localhost:5432/ledgerline?schema=public"
# DIRECT_DATABASE_URL: the table OWNER – used only by migrations and npm run db:roles, never by the running API.
DIRECT_DATABASE_URL="postgresql://ledgerline_app:change-me@localhost:5432/ledgerline?schema=public"

# Public registration can only create ACCOUNT_HOLDER users.
# Create the FIRST ADMIN with the bootstrap command (password typed at a hidden prompt, never stored):
#   npm run admin:bootstrap -- --email you@example.org --name "Your Name"
#
# Optional, LOCAL DEVELOPMENT ONLY: "npm run db:seed" also creates an admin/auditor from these.
# Left empty on purpose – a copied example password would be a publicly known admin password.
# Passwords: 8–72 chars with upper, lower and a digit.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_EMAIL=
SEED_AUDITOR_PASSWORD=

# Local demo data (npm run db:seed:demo) includes demo.admin@example.com unless this is false.
# It is always false on production (scripts/prepare-production-db.js).
SEED_DEMO_ADMIN=true

# Global API requests per IP per 15 minutes
RATE_LIMIT_MAX=600

# Failed logins per IP per 15 min / registrations per IP per hour
AUTH_LOGIN_FAILURE_LIMIT=10
AUTH_REGISTER_LIMIT=10

# Number of proxies in front of the API (0 locally; Render = 1; Vercel rewrite + Render = 2)
TRUST_PROXY=0

# Rate-limit counters (shared, survive restarts). Local Redis in Docker, listening on this computer only:
#   docker run -d --name ledgerline-redis --restart unless-stopped -p 127.0.0.1:6379:6379 redis:7.4.2-alpine redis-server --save "" --appendonly no
# Leave empty to keep counters in memory (development only – the server refuses to start without it in production).
REDIS_URL=redis://127.0.0.1:6379/0
# Failed logins per ACCOUNT (email) per 15 minutes, from any IP
AUTH_ACCOUNT_FAILURE_LIMIT=10
