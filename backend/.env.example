# Copy this file to .env and fill in real values.
# Never commit .env.
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# JWT – generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

# bcrypt cost factor (10–14 is reasonable)
BCRYPT_SALT_ROUNDS=12

# PostgreSQL – use a dedicated app user, not the superuser
DATABASE_URL="postgresql://ledgerline_app:change-me@localhost:5432/ledgerline?schema=public"

# Public registration can only create ACCOUNT_HOLDER users.
# Create the FIRST ADMIN with the bootstrap command (password typed at a hidden prompt, never stored):
#   npm run admin:bootstrap -- --email you@example.org --name "Your Name"
#
# Optional, LOCAL DEVELOPMENT ONLY: "npm run db:seed" also creates an admin/auditor from these.
# Left empty on purpose – a copied example password would be a publicly known admin password.
# Passwords: 8–72 chars with upper, lower and a digit.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_EMAIL=
SEED_AUDITOR_PASSWORD=

# Local demo data (npm run db:seed:demo) includes demo.admin@example.com unless this is false.
# It is always false on production (scripts/prepare-production-db.js).
SEED_DEMO_ADMIN=true

# Global API requests per IP per 15 minutes
RATE_LIMIT_MAX=600

# Failed logins per IP per 15 min / registrations per IP per hour
AUTH_LOGIN_FAILURE_LIMIT=10
AUTH_REGISTER_LIMIT=10

# Number of proxies in front of the API (0 locally; Render = 1; Vercel rewrite + Render = 2)
TRUST_PROXY=0
