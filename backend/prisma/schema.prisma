// LedgerLine database schema.
// All money amounts are stored as BigInt in paise (1 rupee = 100 paise).
// Never store money as Float/Decimal-in-JS.

generator client {
  provider = "prisma-client-js"
}

// Two connections, two database roles (see scripts/setup-db-roles.js):
//   url       – the API's limited role (rows only). Neon: the POOLED host, with pgbouncer=true.
//   directUrl – the table OWNER, used only by `prisma migrate`. Neon: the DIRECT host (no "-pooler"),
//               because migrations need a real session (advisory lock), not a pooled one.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR
}

// Step 4 – onboarding. Self-registered account holders start at PENDING_PROFILE and are approved
// automatically once a valid profile and the current terms are submitted. Until then they can sign in
// but cannot open accounts (enforced by the API AND by the trigger accounts_owner_onboarded).
enum OnboardingStatus {
  PENDING_PROFILE
  APPROVED
}

enum Occupation {
  SALARIED
  SELF_EMPLOYED
  BUSINESS_OWNER
  STUDENT
  HOMEMAKER
  RETIRED
  OTHER
}

enum AccountType {
  CUSTOMER // belongs to a user, can never go negative
  SYSTEM // represents money outside LedgerLine (deposits come from here, withdrawals go here)
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EntryDirection {
  DEBIT // money leaves the account (balance goes down)
  CREDIT // money enters the account (balance goes up)
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum AuditOutcome {
  SUCCESS
  REFUSED
  ERROR
}

// ─────────────────────────── Models ───────────────────────────

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String
  fullName       String
  role           Role     @default(ACCOUNT_HOLDER)
  isActive       Boolean  @default(true)
  // Copied into every JWT ("sv"). Raised on logout and when an admin changes the user's
  // status, which instantly invalidates every token issued before.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Onboarding (step 4). Users that existed before step 4 were marked APPROVED by the migration.
  onboardingStatus OnboardingStatus @default(PENDING_PROFILE)
  onboardedAt      DateTime?
  termsVersion     String?
  termsAcceptedAt  DateTime?

  profile         CustomerProfile?
  accounts        Account[]
  transactions    Transaction[]    @relation("InitiatedBy")
  idempotencyKeys IdempotencyKey[]
  auditLogs       AuditLog[]

  @@index([role])
  @@map("users")
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  accountNumber String        @unique
  type          AccountType   @default(CUSTOMER)
  status        AccountStatus @default(ACTIVE)
  currency      String        @default("INR") @db.Char(3)
  // Cached balance in paise. Must always equal SUM(credits) - SUM(debits) in ledger_entries.
  balance       BigInt        @default(0)
  ownerId       String?       @db.Uuid // null only for SYSTEM accounts
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  outgoing      Transaction[] @relation("FromAccount")
  incoming      Transaction[] @relation("ToAccount")
  ledgerEntries LedgerEntry[]

  @@index([ownerId])
  @@index([type])
  @@map("accounts")
}

model Transaction {
  id            String            @id @default(uuid()) @db.Uuid
  reference     String            @unique // human-readable, e.g. TXN-20261106-AB12CD
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amount        BigInt // paise, always > 0
  currency      String            @default("INR") @db.Char(3)
  fromAccountId String            @db.Uuid // account that is debited
  toAccountId   String            @db.Uuid // account that is credited
  initiatedById String            @db.Uuid
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  fromAccount    Account         @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount      Account         @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  initiatedBy    User            @relation("InitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  ledgerEntries  LedgerEntry[]
  idempotencyKey IdempotencyKey?

  @@index([fromAccountId, createdAt])
  @@index([toAccountId, createdAt])
  @@index([initiatedById, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

// Append-only. Never updated or deleted (enforced by a database trigger).
model LedgerEntry {
  id            String         @id @default(uuid()) @db.Uuid
  // Global sequence number assigned at insert time (after the account row is locked),
  // so entries for one account are strictly ordered – used by statements and verification.
  entryNumber   BigInt         @unique @default(autoincrement())
  transactionId String         @db.Uuid
  accountId     String         @db.Uuid
  direction     EntryDirection
  amount        BigInt // paise, always > 0
  balanceAfter  BigInt // account balance right after this entry
  createdAt     DateTime       @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  // One debit and one credit per transaction – never two of the same kind.
  @@unique([transactionId, direction])
  @@index([accountId, entryNumber])
  @@map("ledger_entries")
}

// Used on Day 2 to make retried requests safe (no double payments).
model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  key            String // value of the Idempotency-Key header
  userId         String            @db.Uuid
  endpoint       String // e.g. POST /api/transactions/transfer
  requestHash    String // SHA-256 of the request body, to detect key reuse with a different body
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  transactionId  String?           @unique @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Append-only security log: successful actions AND refused attempts.
model AuditLog {
  id         String       @id @default(uuid()) @db.Uuid
  actorId    String?      @db.Uuid // null for anonymous attempts (e.g. failed login)
  action     String // e.g. AUTH_LOGIN, TXN_WITHDRAW
  outcome    AuditOutcome
  entityType String? // e.g. Account, Transaction
  entityId   String?
  reason     String? // why it was refused, e.g. INSUFFICIENT_FUNDS
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([outcome, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Personal details submitted during onboarding (step 4) – DEMO DATA ONLY, users are told not to enter real
// information. One row per account holder; the API role may only read and insert it (no UPDATE/DELETE).
model CustomerProfile {
  userId      String     @id @db.Uuid
  user        User       @relation(fields: [userId], references: [id])
  dateOfBirth DateTime   @db.Date
  phone       String // normalised to +91XXXXXXXXXX
  city        String
  state       String // an Indian state or union territory (validated by the API)
  pinCode     String
  occupation  Occupation
  createdAt   DateTime   @default(now())

  @@map("customer_profiles")
}
