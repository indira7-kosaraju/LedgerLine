# Copy to .env.test. Used only by "npm test" – point it at a SEPARATE, disposable database.
# Create it once:  createdb -O ledgerline_app ledgerline_test
NODE_ENV=test
PORT=4001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_MAX=100000
# Same two roles as .env (the role exists once per PostgreSQL server, so use the SAME API password as in .env)
DATABASE_URL="postgresql://ledgerline_api:change-me-to-a-long-random-password@localhost:5432/ledgerline_test?schema=public"
DIRECT_DATABASE_URL="postgresql://ledgerline_app:change-me@localhost:5432/ledgerline_test?schema=public"

# Generous auth limits so automated tests can create many users (production defaults: 10)
AUTH_LOGIN_FAILURE_LIMIT=100000
AUTH_REGISTER_LIMIT=100000

# Test-only privileged users (seeded into ledgerline_test for the browser tests)
SEED_ADMIN_EMAIL=admin@test.local
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_AUDITOR_EMAIL=auditor@test.local
SEED_AUDITOR_PASSWORD=change-me-Auditor1

# Same local Redis, database 1 and key prefix "ll:test:" – tests never touch development counters.
# Required: npm test refuses to run without it (start it with: docker start ledgerline-redis).
REDIS_URL=redis://127.0.0.1:6379/1
AUTH_ACCOUNT_FAILURE_LIMIT=100000
